# Example environment variables (copy to .env and fill in real values)
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection:
# Recommended fast model: gemini-flash-lite-latest (~3-5s low latency responses)
# Standard models: gemini-flash-latest, gemini-3.5-flash
GEMINI_MODEL=gemini-flash-lite-latest

# HTTP Client Timeout in seconds (default: 30)
GEMINI_TIMEOUT_SECONDS=30

# Character limit for summarization prompt condensation (default: 16000)
MAX_SUMMARY_CHARACTERS=16000
