# =============================================================================
# PDF Analyzer GenAI - Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure values appropriate for your environment:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# DO NOT commit real production secrets or API keys to version control.
# =============================================================================

# Environment mode: 'development', 'production', or 'testing'
FLASK_ENV=development

# Secret key for signing session cookies and CSRF tokens:
# - In development, falls back to an internal dev key if left unset.
# - In production, a strong random secret of at least 16 characters is strictly required.
#   Generate a cryptographically secure key with:
#     python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Local Development Server Binding (used only by 'python app.py'):
# Defaults: HOST=127.0.0.1, PORT=5000, FLASK_DEBUG=0
# In production, serve with a production WSGI server (e.g. Waitress).
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# Security & Reverse Proxy Configuration:
# - SESSION_COOKIE_SECURE: Enforces HTTPS transmission for session cookies (mitigates man-in-the-middle).
#   Defaults to false in development; defaults to true in production.
#   Uncomment to explicitly override for your environment:
# SESSION_COOKIE_SECURE=true
#
# - ENABLE_HSTS: Emits 'Strict-Transport-Security: max-age=31536000; includeSubDomains'.
#   Defaults to false. Must only be enabled when deployed over HTTPS.
# - USE_PROXY_FIX: Enables Werkzeug ProxyFix middleware to trust forwarded headers
#   (X-Forwarded-For, X-Forwarded-Proto, X-Forwarded-Host). Defaults to false.
#   Only enable when running behind a trusted reverse proxy (Nginx, Caddy, AWS ALB).
# - PROXY_COUNT: Number of trusted upstream proxies (must be a positive integer, default: 1).
# - TRUST_INCOMING_REQUEST_ID: Accepts and sanitizes incoming X-Request-ID headers matching ^[a-zA-Z0-9_-]{1,64}$.
#   Defaults to false (authoritative server-generated UUID4 is preferred).
#   Enable only when deployed behind a trusted API gateway or edge proxy.
ENABLE_HSTS=false
USE_PROXY_FIX=false
PROXY_COUNT=1
TRUST_INCOMING_REQUEST_ID=false

# Persistent Storage Locations (Optional overrides for persistent volume mounts):
# Defaults: UPLOAD_FOLDER=uploads, DATABASE_PATH=instance/pdf_analyzer.db
# In containerized/cloud deployments (Render, Railway, VPS), point these to persistent volume mounts:
# UPLOAD_FOLDER=/var/data/uploads
# DATABASE_PATH=/var/data/pdf_analyzer.db

# Google Gemini API Configuration:
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection:
# - gemini-flash-lite-latest: Recommended default for low-latency (~3-5s) responses
# - gemini-flash-latest: Standard balance of latency and capacity
# - gemini-3.5-flash: Advanced reasoning tier
GEMINI_MODEL=gemini-flash-lite-latest

# Text Embedding Model Selection:
# - gemini-embedding-001: Official Google Gemini text embedding model
EMBEDDING_MODEL=gemini-embedding-001

# Safe batch size for document chunk embeddings (default: 50)
EMBEDDING_BATCH_SIZE=50

# Semantic Chunking Configuration (character counts):
# - CHUNK_SIZE: Target maximum character count per chunk (default: 800)
# - CHUNK_OVERLAP: Character overlap between consecutive chunks (default: 150)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# HTTP Client Timeout in seconds for Gemini API calls (default: 30)
GEMINI_TIMEOUT_SECONDS=30

# Character limit for summarization prompt condensation (default: 16000)
MAX_SUMMARY_CHARACTERS=16000

# PDF Extraction & Resource Limits:
# - MAX_PDF_PAGES: Maximum allowed pages per document (default: 100)
# - MAX_EXTRACTED_CHARACTERS: Maximum extracted characters across all pages (default: 250000)
MAX_PDF_PAGES=100
MAX_EXTRACTED_CHARACTERS=250000

# Q&A Session Cookie History Bounds:
# Controls client session-cookie payload size to prevent 4096-byte cookie overflow
# - MAX_QA_HISTORY_TURNS: Maximum conversation turns preserved in session (default: 5)
# - MAX_QA_QUESTION_CHARS: Maximum characters per preserved question (default: 120)
# - MAX_QA_ANSWER_CHARS: Maximum characters per preserved answer excerpt (default: 140)
MAX_QA_HISTORY_TURNS=5
MAX_QA_QUESTION_CHARS=120
MAX_QA_ANSWER_CHARS=140
